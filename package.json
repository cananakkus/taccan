{
  "name": "taccan",
  "version": "1.0.0",
  "description": "Realtime Codenames clone with Socket.IO",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test --test-force-exit",
    "build": "esbuild frontend/app.js --bundle --outfile=frontend/app.bundle.js --format=esm --minify --sourcemap --target=es2020"
  },
  "keywords": [
    "codenames",
    "multiplayer",
    "socket.io",
    "word-game"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.1"
  }
}
