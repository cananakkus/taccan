{
  "name": "taccan",
  "version": "1.0.0",
  "description": "Realtime Codenames clone with Socket.IO",
  "main": "backend/server.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:server": "node --watch backend/server.js",
    "dev:client": "vite --config frontend/vite.config.ts",
    "test": "node --test --test-force-exit",
    "test:unit": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build --config frontend/vite.config.ts"
  },
  "keywords": [
    "codenames",
    "multiplayer",
    "socket.io",
    "word-game"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "pinia": "^3.0.4",
    "socket.io": "^4.8.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.1",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
